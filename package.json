{
  "name": "flexirova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:themes": "node scripts/theme-test.mjs",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "seed": "node scripts/seed.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs docs/*.md README.md"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.90.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
